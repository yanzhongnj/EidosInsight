{
  "manifest_version": 3,
  "name": "EidosInsight",
  "version": "1.0.0",
  "description": "一键保存学术论文到 EidosInsight 知识库",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "EidosInsight — 保存论文",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/*",
        "https://www.arxiv.org/*",
        "https://doi.org/*",
        "https://dl.acm.org/*",
        "https://ieeexplore.ieee.org/*",
        "https://www.semanticscholar.org/*",
        "https://openreview.net/*",
        "https://papers.nips.cc/*",
        "https://proceedings.mlr.press/*",
        "https://aclanthology.org/*",
        "https://www.nature.com/*",
        "https://www.science.org/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://link.springer.com/*",
        "https://www.sciencedirect.com/*",
        "https://scholar.google.com/*"
      ],
      "js": ["content/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://doi.org/*",
    "https://dl.acm.org/*",
    "https://ieeexplore.ieee.org/*",
    "https://www.semanticscholar.org/*",
    "https://openreview.net/*",
    "https://papers.nips.cc/*",
    "https://proceedings.mlr.press/*",
    "https://aclanthology.org/*",
    "https://www.nature.com/*",
    "https://pubmed.ncbi.nlm.nih.gov/*",
    "https://link.springer.com/*",
    "https://www.sciencedirect.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "快速保存当前页面论文"
    }
  }
}
